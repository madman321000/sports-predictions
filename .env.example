# Copy this file to .env and edit local settings. Never commit .env.
# PostgreSQL container and host connection settings
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports
POSTGRES_DB=sportsdb
POSTGRES_PORT=5432

# Keep connection URLs in sync with the PostgreSQL settings above.
# URL-encode special characters in credentials when editing these URLs.
DATABASE_URL=postgres://sports:sports@localhost:5432/sportsdb?sslmode=disable
TEST_DATABASE_URL=postgres://sports:sports@localhost:5432/sportsdb?sslmode=disable

# ESPN provider settings
ESPN_BASE_URL=https://site.api.espn.com
ESPN_REQUEST_INTERVAL=5s
ESPN_HTTP_TIMEOUT=20s
# For a full-season game or player backfill, increase to 4h; interrupted runs resume.
INGEST_TIMEOUT=5m

# Bounded game-date workers (1-4); all share one paced ESPN client.
INGEST_WORKERS=1
