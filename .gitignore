# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local environment files; keep the sanitized template tracked.
.env
.env.*
!.env.example

# Editor/IDE
# .idea/
# .vscode/

# Generated coverage reports
coverage.html
coverage.txt

# Local data exports
/exports/

# Offline Python modeling
modeling/.venv/
modeling/runs/
__pycache__/
*.pyc
.coverage
modeling-coverage.xml
/published/
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Local deployment tooling
.vercel/

# Local PostgreSQL connection files
.pg_service.conf
.pgpass

# Locally exported inference models
/models/serving/
